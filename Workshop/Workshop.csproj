<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>Workshop</AssemblyName>
    <RootNamespace>Workshop</RootNamespace>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <Version>1.0.0</Version>
    <Product>ورشة الصيانة</Product>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
    <!-- تشفير رمز تيليجرام وكلمة مرور البريد بحساب ويندوز الحالي -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- الخطوط مضمّنة داخل البرنامج: لا حاجة لتثبيتها على جهاز المستخدم -->
    <EmbeddedResource Include="Assets\*.ttf" />
    <None Include="Assets\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
